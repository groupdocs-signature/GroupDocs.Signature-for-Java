# Build frontend
FROM node:14-bullseye AS frontend
WORKDIR /usr/local/build
COPY client ./client
COPY src ./src
WORKDIR /usr/local/build/client
ENV CYPRESS_INSTALL_BINARY=0
RUN npm install && npm run build

# Build the project
FROM maven:3-eclipse-temurin-11 AS builder
COPY pom.xml /usr/local/build/pom.xml
COPY src /usr/local/build/src/
COPY client /usr/local/build/client
COPY --from=frontend /usr/local/build/src/main/resources/assets /usr/local/build/src/main/resources/assets
WORKDIR /usr/local/build
ENV JAVA_TOOL_OPTIONS="-Djdk.jar.maxSignatureFileSize=32000000"
ENV MAVEN_OPTS="-Djdk.jar.maxSignatureFileSize=32000000"
RUN mvn clean package -Dmaven.test.skip=true -Dfrontend.skip=true

# Configure Docker Image
FROM eclipse-temurin:11-jre-jammy

RUN apt-get update && \
    echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        fontconfig software-properties-common && \
    apt-add-repository multiverse && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ttf-mscorefonts-installer && \
    fc-cache -f && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /home/groupdocs/app && \
    mkdir -p /home/groupdocs/app/DocumentSamples/Output && \
    mkdir -p /home/groupdocs/app/Licenses
COPY configuration.yml /home/groupdocs/app/configuration.yml
COPY --from=builder /usr/local/build/target/signature-*.jar /home/groupdocs/app/app.jar
WORKDIR /home/groupdocs/app

ENV LIC_PATH="Licenses"
ENV DOWNLOAD_ON=true
ENV UPLOAD_ON=true
ENV FILES_DIR="DocumentSamples"
ENV HOST_ADDRESS=""

LABEL version="26.5" \
      maintainer="GroupDocs Team" \
      url="https://products.groupdocs.com/signature/java" \
      documentation="https://docs.groupdocs.com/signature/java" \
      source="https://github.com/groupdocs-signature/GroupDocs.Signature-for-Java" \
      description="GroupDocs.Signature for Java Dropwizard sample, based on Eclipse Temurin 11"

EXPOSE 8080

VOLUME [ "/home/groupdocs/app", "/home/groupdocs/app/DocumentSamples", "/home/groupdocs/app/Licenses" ]

ENTRYPOINT [ "java", "-Djava.awt.headless=true", "-jar", "app.jar", "configuration.yml" ]
